# NOOKORA Environment Configuration Template
# Copy this file to .env.local for local development. Never commit real keys.

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Future Supabase Integration (Optional - App runs with built-in mock services)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Analytics & Observability (Optional)
NEXT_PUBLIC_ANALYTICS_ID=
